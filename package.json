    "electron": "^44.4.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6"
  }
