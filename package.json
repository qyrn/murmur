{
  "name": "dictee-perso",
  "version": "1.0.0",
  "description": "Dictee privee en francais avec transcription locale (whisper.cpp + CUDA)",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
