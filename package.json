{
  "name": "murmur",
  "version": "1.5.0",
  "description": "Dictée vocale locale pour le français, transcrite par whisper.cpp sur la carte graphique",
  "author": "qyrn",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/copy-vad-assets.mjs && electron-vite dev",
    "build": "node scripts/copy-vad-assets.mjs && electron-vite build",
    "build:win": "pnpm build && electron-builder --win",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "build:linux": "pnpm build && electron-builder --linux"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "get-windows"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/krona-one": "^5.3.0",
    "@ricky0123/vad-web": "^0.0.31",
    "@types/node": "^22.20.3",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.8.9",
    "get-windows": "^9.3.0"
  },
  "build": {
    "appId": "dev.qyrn.murmur",
    "productName": "murmur",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/tray",
        "to": "tray"
      },
      {
        "from": "whisper-engine/whisper.cpp/build/bin",
        "to": "whisper-engine/whisper.cpp/build/bin",
        "filter": [
          "whisper-server",
          "whisper-server.exe",
          "*.dll",
          "*.so",
          "*.so.*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerSidebar": "resources/installer/sidebar.bmp",
      "uninstallerSidebar": "resources/installer/sidebar.bmp",
      "installerHeader": "resources/installer/header.bmp",
      "include": "resources/installer/installer.nsh",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "fr_FR",
        "en_US"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "murmur",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "differentialPackage": true
    },
    "publish": {
      "provider": "github",
      "owner": "qyrn",
      "repo": "murmur",
      "releaseType": "draft"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-x86_64.${ext}",
      "icon": "resources/icon.png",
      "category": "Utility"
    },
    "copyright": "Copyright © 2026 qyrn"
  }
}
